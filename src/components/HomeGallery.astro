---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import Img from './Img.astro';
import { galleryPhotos } from '../data/gallery';

import exterior1 from '../assets/hospital/exterior-1.jpg';

// Curated genuine photographs of the hospital. Tiles are rendered through Img,
// which ships tile-sized WebP (not the 1400px originals) and loads lazily.
const curated = [
  { img: exterior1, alt: 'Medilife Superspeciality Hospital building, Dehradun' },
  ...galleryPhotos.map((g) => ({ img: g.src, alt: g.alt })),
];

const half = Math.ceil(curated.length / 2);
const rows = [curated.slice(0, half), curated.slice(half)];
const dirClass = ['marquee-left', 'marquee-right'];
---

<section class="section overflow-hidden">
  <div class="container-x">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <SectionHeading
        eyebrow="Photo Gallery"
        title="A look inside Medilife"
        subtitle="Real photos of our hospital, modern theatres, diagnostics and the caring spaces built around our patients."
        align="left"
        class="max-w-xl"
      />
      <div class="flex flex-wrap gap-3">
        <button type="button" class="btn btn-ghost" data-marquee-toggle aria-pressed="false">
          <span data-label>Pause photos</span>
        </button>
        <a href="/photo-gallery" class="btn btn-ghost">
          View full gallery <Icon name="arrowRight" class="h-5 w-5" />
        </a>
      </div>
    </div>
  </div>

  <!-- Continuous marquee (full-bleed) -->
  <div class="reveal mt-10 flex flex-col gap-4" data-marquee-group>
    {rows.map((row, ri) => (
      <div class="marquee" tabindex="0" role="group" aria-label={`Medilife hospital photos, row ${ri + 1}`}>
        <ul class:list={['marquee-track', dirClass[ri]]}>
          {[...row, ...row].map((it, i) => (
            <li class="marquee-item">
              <Img
                src={it.img}
                width={304}
                height={208}
                sizes="(min-width: 640px) 19rem, 16rem"
                alt={i < row.length ? it.alt : ''}
                class="h-full w-full object-cover"
                loading="lazy"
                aria-hidden={i >= row.length ? 'true' : undefined}
              />
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>

<script>
  // WCAG 2.2.2: let everyone (keyboard and touch included) pause the moving photos.
  function initMarqueeToggle() {
    document.querySelectorAll<HTMLButtonElement>('[data-marquee-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const group = btn.closest('section')?.querySelector<HTMLElement>('[data-marquee-group]');
      const label = btn.querySelector('[data-label]');
      btn.addEventListener('click', () => {
        const paused = !group?.classList.contains('marquee-paused');
        group?.classList.toggle('marquee-paused', paused);
        btn.setAttribute('aria-pressed', String(paused));
        if (label) label.textContent = paused ? 'Play photos' : 'Pause photos';
      });
    });
  }
  document.addEventListener('astro:page-load', initMarqueeToggle);
</script>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 4%, #000 96%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .marquee-item {
    flex: 0 0 auto;
    width: 16rem;
    height: 11rem;
    margin-right: 1rem;
    overflow: hidden;
    border-radius: 1rem;
    box-shadow: var(--shadow-soft);
    outline: 1px solid var(--color-ink-100);
    transition: transform 0.3s ease;
  }
  @media (min-width: 640px) {
    .marquee-item {
      width: 19rem;
      height: 13rem;
    }
  }
  .marquee-item:hover {
    transform: scale(1.03);
  }
  .marquee-item img {
    transition: transform 0.5s ease;
  }
  .marquee-item:hover img {
    transform: scale(1.08);
  }
  .marquee-left {
    animation: marquee-left 55s linear infinite;
  }
  .marquee-right {
    animation: marquee-right 55s linear infinite;
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track,
  .marquee-paused .marquee-track {
    animation-play-state: paused;
  }
  @keyframes marquee-left {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee-left,
    .marquee-right {
      animation: none;
    }
  }
</style>
