---
/**
 * Responsive <img> for imported assets.
 *
 * Production builds generate resized WebP files at build time (static output,
 * no runtime /_image endpoint) at 1x / 1.5x / 2x of the rendered width, capped
 * at the source width, with a matching srcset. In `astro dev` it serves the
 * original file directly, which keeps local previews reliable.
 *
 * `width`/`height` describe the rendered box (they set the aspect ratio for
 * layout; CSS object-fit handles cropping). Generated files keep the source
 * aspect ratio, so nothing is cropped at build time.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  width?: number;
  height?: number;
  /** Responsive sizes attribute; defaults to "up to the rendered width". */
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  decoding?: 'async' | 'sync' | 'auto';
  fetchpriority?: 'high' | 'low' | 'auto';
  [key: string]: unknown;
}

const {
  src,
  alt,
  width,
  height,
  sizes,
  class: className,
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  ...rest
} = Astro.props;

const boxW = Math.round(width ?? src.width);
const boxH = Math.round(height ?? (width ? (width * src.height) / src.width : src.height));

let imgSrc = src.src;
let srcset: string | undefined;

if (import.meta.env.PROD && src.format !== 'svg') {
  // With object-cover the image must be at least this wide to fill the box at 1x.
  const coverW = height ? Math.max(boxW, Math.ceil((boxH * src.width) / src.height)) : boxW;
  const targets = [...new Set([coverW, coverW * 1.5, coverW * 2].map((w) => Math.min(Math.round(w), src.width)))];
  const out = await Promise.all(targets.map((w) => getImage({ src, width: w, format: 'webp', quality: 78 })));
  imgSrc = out[0].src;
  srcset = targets.length > 1 ? out.map((o, i) => `${o.src} ${targets[i]}w`).join(', ') : undefined;
}
const sizesAttr = srcset ? (sizes ?? `(max-width: ${boxW}px) 100vw, ${boxW}px`) : undefined;
---

<img
  src={imgSrc}
  srcset={srcset}
  sizes={sizesAttr}
  alt={alt}
  width={boxW}
  height={boxH}
  class={className}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  {...rest}
/>
