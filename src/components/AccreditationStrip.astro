---
/**
 * Empanelment & certification fold: every scheme / quality logo in one place.
 * Scheme logos come from src/assets/logos/schemes/<slug>.* (see insurance.ts);
 * a scheme without a file shows a text badge. Optionally lists insurer / TPA
 * logos (src/assets/logos/insurers) with a link to the full list.
 */
import Img from './Img.astro';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';
import nabhLogo from '../assets/badges/nabh.png';
import abdmLogo from '../assets/badges/abdm.png';
import pmjayLogo from '../assets/badges/pmjay.png';
import { nabh as nabhCert } from '../data/schema';
import { schemeLogo, insurerLogo, tpaList, institutions } from '../data/insurance';

interface Props {
  /** Show the "see insurance facilities" link (off on /insurance itself). */
  insuranceLink?: boolean;
  /** Show the insurer / TPA / institution logo carousel under the scheme tiles. */
  carousel?: boolean;
}
const { insuranceLink = true, carousel = false } = Astro.props;

interface Badge {
  label: string;
  sub: string;
  alt: string;
  logo?: ImageMetadata;
  /** Text badge when there is no logo file */
  mark?: string;
  icon?: string;
}

// Carousel: every insurer / TPA and institutional tie-up; logo when a file
// exists, otherwise a name tile, so the list is always complete.
const partners = [...tpaList, ...institutions].map((name) => ({ name, logo: insurerLogo(name) }));
const half = Math.ceil(partners.length / 2);
const rows = carousel ? [partners.slice(0, half), partners.slice(half)] : [];

const badges: Badge[] = [
  { logo: nabhLogo, alt: 'NABH Entry Level certified (Small Healthcare Organisation)', label: 'NABH', sub: 'Entry Level certified' },
  { logo: schemeLogo('CGHS'), mark: 'CGHS', alt: 'CGHS - Central Government Health Scheme', label: 'CGHS', sub: 'Empanelled' },
  { logo: schemeLogo('SGHS'), mark: 'SGHS', alt: 'SGHS - State Government Health Scheme, Uttarakhand', label: 'SGHS', sub: 'Empanelled' },
  { logo: schemeLogo('CAPF'), mark: 'CAPF', alt: 'CAPF Golden Card scheme', label: 'CAPF (Golden Card)', sub: 'Empanelled' },
  { logo: pmjayLogo, alt: 'Ayushman Bharat PM-JAY', label: 'Ayushman Bharat', sub: 'PM-JAY card accepted' },
  { logo: abdmLogo, alt: 'Ayushman Bharat Digital Mission (ABDM)', label: 'ABDM', sub: 'ABHA enabled' },
  { icon: 'shield', alt: '', label: 'Insurance & TPA', sub: 'Cashless, on approval' },
];
---

<section class="border-y border-ink-100 bg-white" aria-labelledby="empanelment-heading">
  <div class="container-x py-12">
    <p class="text-center text-sm font-semibold uppercase tracking-[0.14em] text-brand-700">Empanelment &amp; certification</p>
    <h2 id="empanelment-heading" class="mt-2 text-center text-2xl font-bold text-ink-900 sm:text-3xl">
      Empanelled under CGHS, SGHS &amp; CAPF, NABH Entry Level certified
    </h2>
    <ul class="mt-8 flex flex-wrap justify-center gap-3 lg:gap-4">
      {badges.map((b) => (
        <li class="flex w-[calc(50%-0.375rem)] flex-col items-center gap-3 text-center sm:w-36">
          <span class="flex h-24 w-full items-center justify-center rounded-2xl border border-ink-100 bg-white p-4 shadow-soft">
            {b.logo ? (
              <Img src={b.logo} alt={b.alt} width={80} class="h-16 w-auto max-w-full object-contain" loading="lazy" />
            ) : b.mark ? (
              <span class="font-display text-2xl font-extrabold tracking-wide text-brand-800" aria-hidden="true">{b.mark}</span>
            ) : (
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-50 text-brand-600" aria-hidden="true">
                <Icon name={b.icon ?? 'shield'} class="h-7 w-7" />
              </span>
            )}
          </span>
          <span class="leading-tight">
            <span class="block text-sm font-bold text-ink-900">{b.label}</span>
            <span class="block text-xs text-ink-600">{b.sub}</span>
          </span>
        </li>
      ))}
    </ul>
    {rows.length > 0 && (
      <div class="mt-12">
        <h3 class="text-center text-base font-bold text-ink-900">
          {partners.length} insurance companies, TPAs &amp; institutions we work with
        </h3>
        <div class="relative mt-6">
        <div class="flex flex-col gap-3" data-logo-marquee>
          {rows.map((row, ri) => (
            <div class="logo-marquee" role="group" aria-label={`Empanelled insurers and TPAs, row ${ri + 1}`}>
              <ul class:list={['logo-track', ri === 0 ? 'logo-left' : 'logo-right']}>
                {[...row, ...row].map((x, i) => {
                  const dup = i >= row.length;
                  return (
                    <li class="logo-item" aria-hidden={dup ? 'true' : undefined}>
                      {x.logo ? (
                        <Img src={x.logo} alt={dup ? '' : x.name} width={140} class="max-h-full w-auto max-w-full object-contain" loading="lazy" />
                      ) : (
                        <span class="text-center text-xs font-bold leading-snug text-ink-800">{x.name}</span>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
          <button
            type="button"
            class="absolute right-1 top-1/2 z-10 grid h-10 w-10 -translate-y-1/2 place-items-center rounded-full bg-white text-brand-700 shadow-card ring-1 ring-ink-200 transition hover:bg-brand-50"
            data-logo-marquee-toggle
            aria-label="Pause logo carousel"
          >
            <Icon name="pause" class="h-4 w-4" data-icon-pause />
            <Icon name="play" class="hidden h-4 w-4" data-icon-play />
          </button>
        </div>
        <p class="mt-5 text-center text-sm">
          <a href="/insurance#insurers" class="font-semibold text-brand-700 underline underline-offset-2">See the full list of insurers &amp; TPAs</a>
        </p>
      </div>
    )}
    <p class="mt-8 text-center text-xs leading-relaxed text-ink-600">
      NABH Entry Level certificate no. {nabhCert.certificateNo}, valid to {nabhCert.validThroughLabel}.
      <a href={nabhCert.pdf} target="_blank" rel="noopener" class="font-semibold text-brand-700 underline underline-offset-2">View certificate (PDF)</a>
    </p>
    {insuranceLink && (
      <p class="mt-5 text-center">
        <a href="/insurance" class="btn btn-ghost">Insurance facilities <Icon name="arrowRight" class="h-5 w-5" /></a>
      </p>
    )}
  </div>
</section>

<script>
  // WCAG 2.2.2: anyone can pause the moving logos (hover/focus also pauses).
  function initLogoMarquee() {
    document.querySelectorAll<HTMLButtonElement>('[data-logo-marquee-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      const group = btn.closest('section')?.querySelector<HTMLElement>('[data-logo-marquee]');
      btn.addEventListener('click', () => {
        const paused = !group?.classList.contains('logo-paused');
        group?.classList.toggle('logo-paused', paused);
        btn.setAttribute('aria-label', paused ? 'Play logo carousel' : 'Pause logo carousel');
        btn.querySelector('[data-icon-pause]')?.classList.toggle('hidden', paused);
        btn.querySelector('[data-icon-play]')?.classList.toggle('hidden', !paused);
      });
    });
  }
  document.addEventListener('astro:page-load', initLogoMarquee);
</script>

<style>
  .logo-marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }
  .logo-track {
    display: flex;
    width: max-content;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .logo-item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 8.5rem;
    height: 4.5rem;
    margin-right: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 0.875rem;
    background: #fff;
    box-shadow: var(--shadow-soft);
    outline: 1px solid var(--color-ink-100);
  }
  @media (min-width: 640px) {
    .logo-item {
      width: 10rem;
      height: 5rem;
      margin-right: 1rem;
    }
  }
  .logo-left {
    animation: logo-left 60s linear infinite;
  }
  .logo-right {
    animation: logo-right 60s linear infinite;
  }
  .logo-marquee:hover .logo-track,
  .logo-marquee:focus-within .logo-track,
  .logo-paused .logo-track {
    animation-play-state: paused;
  }
  @keyframes logo-left {
    to {
      transform: translateX(-50%);
    }
  }
  @keyframes logo-right {
    from {
      transform: translateX(-50%);
    }
    to {
      transform: translateX(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-logo-marquee-toggle] {
      display: none;
    }
    .logo-marquee {
      overflow-x: auto;
    }
    .logo-left,
    .logo-right {
      animation: none;
    }
  }
</style>
