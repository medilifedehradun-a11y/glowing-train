---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Img from '../../components/Img.astro';
import Icon from '../../components/Icon.astro';
import { doctors, type Doctor } from '../../data/doctors';
import { departments } from '../../data/departments';
import { videos } from '../../data/videos';
import { site, contact } from '../../data/site';
import { doctorNode } from '../../data/schema';
import { getImage } from 'astro:assets';

export function getStaticPaths() {
  return doctors.map((d) => ({ params: { slug: d.slug }, props: { doctor: d } }));
}

const { doctor } = Astro.props as { doctor: Doctor };
const dept = departments.find((x) => x.slug === doctor.department);

/** Plain-language role used in the <title> and intro, e.g. "Urologist". */
const ROLE: Record<string, string> = {
  urology: 'Urologist',
  ent: 'ENT Specialist',
  oncology: 'Onco-Surgeon',
  orthopedics: 'Orthopaedic Surgeon',
  'general-medicine': 'General Physician',
  'general-surgery': 'General Surgeon',
  'plastic-surgery': 'Plastic Surgeon',
  'pediatric-cardiology': 'Pediatric Cardiologist',
  physiotherapy: 'Physiotherapist',
  audiology: 'Audiologist',
};
const role = (doctor.department && ROLE[doctor.department]) || doctor.specialtyTag;
const firstName = doctor.name.split(' ').slice(0, 2).join(' ');

const descriptionFull = [
  `${doctor.name}, ${role.toLowerCase().startsWith('ent') ? role : role.toLowerCase()} at Medilife Superspeciality Hospital, Dehradun.`,
  doctor.qualifications ? `${doctor.qualifications}.` : undefined,
  doctor.opd ? `OPD: ${doctor.opd}.` : 'Book an appointment online or call us.',
]
  .filter(Boolean)
  .join(' ')
  .replace(/\s+\./g, '.');
// Keep descriptions <= ~158 chars, cutting on a word boundary.
const description =
  descriptionFull.length <= 158 ? descriptionFull : descriptionFull.slice(0, 156).replace(/\s+\S*$/, '') + '…';

// "<Name>, <Role> in Dehradun | Medilife", dropping the brand when it would pass ~62 chars.
const baseTitle = `${doctor.name}, ${role} in Dehradun`;
const pageTitle = baseTitle.length + 11 <= 62 ? `${baseTitle} | Medilife` : baseTitle;

// Social cards need JPEG/PNG (X, WhatsApp, Facebook, LinkedIn ignore AVIF).
const ogImg = doctor.image
  ? await getImage({ src: doctor.image, format: 'jpg', width: Math.min(1200, doctor.image.width), quality: 82 })
  : undefined;

const colleagues = doctors.filter((d) => d.department === doctor.department && d.slug !== doctor.slug);
const doctorVideos = videos.filter((v) => v.doctor === doctor.slug);

const schema = [
  doctorNode(doctor, { withContext: true }),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Doctors', item: new URL('/doctors', site.url).href },
      { '@type': 'ListItem', position: 3, name: doctor.name, item: new URL(`/doctors/${doctor.slug}`, site.url).href },
    ],
  },
];

const parts = doctor.name.replace(/^(Dr\.?|Mohd)\s+/i, '').trim().split(/\s+/).filter(Boolean);
const initials = ((parts[0]?.[0] ?? '') + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
---

<BaseLayout
  fullTitle={pageTitle}
  description={description}
  image={ogImg?.src}
  jsonLd={schema}
>
  <PageHero
    eyebrow={dept ? dept.name : 'Our Doctors'}
    title={doctor.name}
    subtitle={doctor.title}
    crumbs={[{ label: 'Doctors', href: '/doctors' }, { label: doctor.name }]}
  />

  <section class="section">
    <div class="container-x grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="mx-auto w-full max-w-sm overflow-hidden rounded-3xl bg-brand-50 shadow-card ring-1 ring-ink-100">
        {doctor.image ? (
          <Img
            src={doctor.image}
            alt={`${doctor.name}, ${doctor.title}`}
            width={480}
            height={560}
            sizes="(min-width: 1024px) 24rem, 90vw"
            class="aspect-[6/7] h-full w-full object-cover object-top"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="grid aspect-[6/7] place-items-center">
            <span class="font-display text-6xl font-extrabold text-brand-600/90">{initials}</span>
          </div>
        )}
      </div>

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-brand-700">
            {role}
          </span>
          {doctor.visiting && (
            <span class="rounded-full bg-accent-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-accent-700">
              Visiting consultant
            </span>
          )}
        </div>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">{doctor.name}</h2>
        <p class="mt-1 font-semibold text-brand-700">{doctor.title}</p>
        {doctor.qualifications && (
          <p class="mt-3 text-[0.95rem] font-semibold text-ink-700">{doctor.qualifications}</p>
        )}
        <p class="mt-4 text-lg leading-relaxed text-ink-600">{doctor.bio}</p>

        {doctor.opd && (
          <p class="mt-5 inline-flex items-center gap-2 rounded-lg bg-brand-50 px-3 py-2 text-sm font-semibold text-brand-700">
            <Icon name="clock" class="h-4 w-4" /> OPD: {doctor.opd}
          </p>
        )}

        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`/book-online?doctor=${doctor.slug}#appointment-form`} class="btn btn-primary">
            <Icon name="calendar" class="h-5 w-5" /> Book with {firstName}
          </a>
          <a href={contact.phoneHref} class="btn btn-ghost">
            <Icon name="phone" class="h-5 w-5" /> {contact.phoneDisplay}
          </a>
        </div>

        {(doctor.linkedin || doctor.facebook) && (
          <p class="mt-5 flex items-center gap-3 text-sm text-ink-600">
            Profiles:
            {doctor.linkedin && (
              <a href={doctor.linkedin} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-brand-700">
                <Icon name="linkedin" class="h-4 w-4" /> LinkedIn
              </a>
            )}
            {doctor.facebook && (
              <a href={doctor.facebook} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 font-semibold text-brand-700">
                <Icon name="facebook" class="h-4 w-4" /> Facebook
              </a>
            )}
          </p>
        )}
      </div>
    </div>
  </section>

  {dept && (
    <section class="section bg-ink-50/50">
      <div class="container-x">
        <span class="eyebrow">{dept.name}</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">Treatments in the {dept.name} department</h2>
        <ul class="mt-8 flex flex-wrap gap-2.5">
          {dept.procedures.map((p) => (
            <li class="rounded-full bg-white px-4 py-2 text-sm font-medium text-ink-700 shadow-soft ring-1 ring-ink-100">{p}</li>
          ))}
        </ul>
        {dept.conditions && dept.conditions.length > 0 && (
          <>
            <h3 class="mt-10 text-xl font-bold text-ink-900">Conditions treated</h3>
            <ul class="mt-4 flex flex-wrap gap-2.5">
              {dept.conditions.map((c) => (
                <li class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800">{c}</li>
              ))}
            </ul>
          </>
        )}
        <a href={`/${dept.slug}`} class="btn btn-ghost mt-8 whitespace-normal text-left">
          {dept.name} department <Icon name="arrowRight" class="h-5 w-5 shrink-0" />
        </a>
      </div>
    </section>
  )}

  {doctorVideos.length > 0 && (
    <section class="section">
      <div class="container-x">
        <span class="eyebrow">Videos</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">{firstName} explains</h2>
        <ul class="mt-6 flex flex-col gap-2">
          {doctorVideos.map((v) => (
            <li>
              <a href={`/${v.department}`} class="inline-flex items-center gap-2 font-semibold text-brand-700">
                <Icon name="arrowRight" class="h-4 w-4" /> {v.title} ({v.durationLabel})
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {colleagues.length > 0 && (
    <section class="section">
      <div class="container-x">
        <span class="eyebrow">Also in {dept?.name}</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">Other specialists</h2>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {colleagues.map((c) => <DoctorCard doctor={c} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBanner />
</BaseLayout>
