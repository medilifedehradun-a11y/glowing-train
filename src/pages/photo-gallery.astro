---
import Img from '../components/Img.astro';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import VideoCard from '../components/VideoCard.astro';
import { site, contact } from '../data/site';
import { gallery, campaigns } from '../data/gallery';
import { videos } from '../data/videos';

// Large versions for the lightbox (build-time WebP in production).
const fullSrc = await Promise.all(
  gallery.map(async (g) =>
    import.meta.env.PROD
      ? (await getImage({ src: g.src, width: Math.min(1400, g.src.width), format: 'webp', quality: 80 })).src
      : g.src.src
  )
);

const galleryDescription =
  'Photos and videos of Medilife Superspeciality Hospital, Dehradun: our premises, facilities and team, plus short explainers from our specialists.';

const overview = [
  { icon: 'building', label: `${gallery.length} images`, sub: 'Photos, camps & updates' },
  { icon: 'activity', label: 'Premises', sub: 'Building & interiors' },
  { icon: 'users', label: 'Our team', sub: 'Doctors & staff' },
  { icon: 'heartPulse', label: 'Care in action', sub: 'Facilities & events' },
];

const imageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: `Photo Gallery - ${site.name}`,
  url: new URL('/photo-gallery', site.url).href,
  description: galleryDescription,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Photo Gallery', item: new URL('/photo-gallery', site.url).href },
  ],
};
---

<BaseLayout
  title="Photo Gallery"
  description={galleryDescription}
  jsonLd={[imageSchema, breadcrumbSchema]}
>
  <PageHero
    eyebrow="Photo Gallery"
    title="Photo Gallery"
    subtitle="A closer look at Medilife Superspeciality Hospital, Dehradun - our premises, facilities, medical team and the care we deliver every day."
    crumbs={[{ label: 'Photo Gallery' }]}
  />

  <!-- Overview strip -->
  <section class="border-b border-ink-100 bg-white">
    <div class="container-x py-8">
      <div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
        {overview.map((c) => (
          <div class="flex items-center gap-3">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={c.icon} class="h-6 w-6" />
            </span>
            <div class="leading-tight">
              <p class="text-sm font-bold text-ink-900">{c.label}</p>
              <p class="text-xs text-ink-600">{c.sub}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Gallery grid -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        eyebrow="Inside Medilife"
        title="A visual tour of our hospital"
        subtitle="Real moments from Medilife - our infrastructure, our people and the calm, caring environment where we deliver advanced treatment every day."
      />

      <div class="reveal mt-12 grid grid-cols-2 gap-3 sm:grid-cols-3 sm:gap-4 lg:grid-cols-4">
        {gallery.map((item, i) => (
          <figure class="group relative aspect-[4/3] overflow-hidden rounded-2xl shadow-soft ring-1 ring-ink-100">
            <button
              type="button"
              class="block h-full w-full cursor-zoom-in focus-visible:outline-offset-[-4px] focus-visible:shadow-[inset_0_0_0_6px_#fff]"
              data-lightbox-open={i}
              data-full={fullSrc[i]}
              data-alt={item.alt}
              aria-label={`View larger: ${item.alt}`}
            >
            <Img
              src={item.src}
              alt={item.alt}
              width={560}
              height={420}
              class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-110"
              loading={i < 4 ? 'eager' : 'lazy'}
            />
            <span
              class="pointer-events-none absolute inset-0 flex items-center justify-center bg-brand-900/0 opacity-0 transition group-hover:bg-brand-900/30 group-hover:opacity-100 group-focus-within:bg-brand-900/30 group-focus-within:opacity-100"
              aria-hidden="true"
            >
              <span class="grid h-11 w-11 place-items-center rounded-full bg-white/90 text-brand-700">
                <Icon name="plus" class="h-5 w-5" />
              </span>
            </span>
            </button>
          </figure>
        ))}
      </div>

      <p class="mt-8 text-center text-sm text-ink-600">
        Photographs from Medilife Superspeciality Hospital, Dehradun.
      </p>

      <!-- Lightbox: native modal dialog (focus trap, Escape and focus return built in) -->
      <dialog
        id="gallery-lightbox"
        aria-label="Gallery image"
        class="m-auto w-[min(96vw,72rem)] max-w-none rounded-2xl bg-ink-950 p-0 text-white shadow-2xl backdrop:bg-ink-950/80"
      >
        <figure class="flex flex-col">
          <img data-lightbox-img alt="" class="max-h-[78vh] w-full object-contain" />
          <figcaption class="flex items-center gap-3 p-4 text-sm text-white/90">
            <span data-lightbox-caption class="flex-1"></span>
            <span data-lightbox-count class="shrink-0 text-white/70"></span>
          </figcaption>
        </figure>
        <div class="absolute right-3 top-3 flex gap-2">
          <button type="button" data-lightbox-prev aria-label="Previous image" class="grid h-11 w-11 place-items-center rounded-full bg-black/60 text-white hover:bg-black/80"><Icon name="chevronDown" class="h-5 w-5 rotate-90" /></button>
          <button type="button" data-lightbox-next aria-label="Next image" class="grid h-11 w-11 place-items-center rounded-full bg-black/60 text-white hover:bg-black/80"><Icon name="chevronDown" class="h-5 w-5 -rotate-90" /></button>
          <button type="button" data-lightbox-close aria-label="Close" class="grid h-11 w-11 place-items-center rounded-full bg-black/60 text-white hover:bg-black/80"><Icon name="close" class="h-5 w-5" /></button>
        </div>
      </dialog>
    </div>
  </section>

  <!-- Patient-education videos -->
  {videos.length > 0 && (
    <section class="section">
      <div class="container-x">
        <SectionHeading
          eyebrow="Videos"
          title="Watch our specialists explain"
          subtitle="Short videos from our doctors on common procedures and tests, recorded at Medilife Superspeciality Hospital, Dehradun."
        />

        <div class="reveal mt-12 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {videos.map((v) => <VideoCard video={v} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Health awareness campaigns -->
  {campaigns.length > 0 && (
    <section class="section bg-ink-50/50">
      <div class="container-x">
        <SectionHeading
          eyebrow="Health Awareness"
          title="Awareness campaigns from Medilife"
          subtitle="Simple, shareable health guidance from our specialists, covering everyday symptoms and when to seek timely care."
        />

        <div class="reveal mx-auto mt-12 grid max-w-4xl gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {campaigns.map((item) => (
            <figure class="overflow-hidden rounded-2xl bg-white shadow-soft ring-1 ring-ink-100">
              <Img
                src={item.src}
                alt={item.alt}
                width={800}
                height={1000}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Visit / explore strip -->
  <section class="section bg-ink-50/50">
    <div class="container-x">
      <div class="grid items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
        <div class="reveal">
          <span class="eyebrow">Come See For Yourself</span>
          <h2 class="mt-4 text-3xl font-bold leading-tight text-ink-900 sm:text-4xl">
            Photos tell part of the story, your visit tells the rest
          </h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-600">
            We would be glad to welcome you to Medilife Superspeciality Hospital in Dehradun.
            Explore our departments online, or reach out to plan a consultation with our
            specialists. Our team is available round the clock for emergencies.
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/departments" class="btn btn-primary">
              Explore Departments <Icon name="arrowRight" class="h-5 w-5" />
            </a>
            <a href="/facilities" class="btn btn-ghost">
              View Facilities <Icon name="arrowRight" class="h-5 w-5" />
            </a>
          </div>
        </div>

        <div class="reveal grid gap-4">
          <a href={contact.mapUrl} target="_blank" rel="noopener" class="card card-hover flex items-start gap-4 p-5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="pin" class="h-6 w-6" />
            </span>
            <span>
              <span class="block text-sm font-semibold text-ink-600">Visit us</span>
              <span class="block text-base font-bold text-ink-900">
                {contact.addressLine1}, {contact.addressLine2}, {contact.addressCity}
              </span>
            </span>
          </a>
          <a href={contact.phoneHref} class="card card-hover flex items-start gap-4 p-5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="phone" class="h-6 w-6" />
            </span>
            <span>
              <span class="block text-sm font-semibold text-ink-600">Call us</span>
              <span class="block text-lg font-bold text-ink-900">{contact.phoneDisplay}</span>
            </span>
          </a>
          <a href={contact.emailHref} class="card card-hover flex items-start gap-4 p-5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name="mail" class="h-6 w-6" />
            </span>
            <span>
              <span class="block text-sm font-semibold text-ink-600">Email us</span>
              <span class="block text-base font-bold text-ink-900">{contact.email}</span>
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<script>
  function initLightbox() {
    const dlg = document.getElementById('gallery-lightbox') as HTMLDialogElement | null;
    if (!dlg || dlg.dataset.bound) return;
    dlg.dataset.bound = '1';
    const tiles = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-lightbox-open]'));
    const img = dlg.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    const count = dlg.querySelector<HTMLElement>('[data-lightbox-count]')!;
    let idx = 0;
    const show = (i: number) => {
      idx = (i + tiles.length) % tiles.length;
      const t = tiles[idx];
      img.src = t.dataset.full || '';
      img.alt = t.dataset.alt || '';
      cap.textContent = t.dataset.alt || '';
      count.textContent = `${idx + 1} / ${tiles.length}`;
    };
    tiles.forEach((t, i) => t.addEventListener('click', () => { show(i); dlg.showModal(); }));
    dlg.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(idx + 1));
    dlg.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    // Click on the backdrop closes the dialog.
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', () => tiles[idx]?.focus());
  }
  document.addEventListener('astro:page-load', initLightbox);
</script>
