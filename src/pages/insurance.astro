---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContactForm from '../components/ContactForm.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import AccreditationStrip from '../components/AccreditationStrip.astro';
import pmjayBadge from '../assets/badges/pmjay.png';
import { site, contact } from '../data/site';
import { hospitalRef } from '../data/schema';
import {
  empanelmentLine,
  governmentSchemes,
  tpaServices,
  tpaList,
  institutions,
  insurerLogo,
  schemeLogo,
  insuranceDocuments,
} from '../data/insurance';

const title = 'Insurance, TPA & Government Health Schemes';
const description =
  'Medilife Hospital, Dehradun is empanelled under CGHS, SGHS and CAPF, and accepts Ayushman Bharat PM-JAY and 30+ health insurers and TPAs for cashless care.';

const steps = [
  {
    title: 'Talk to our insurance desk',
    text: 'Call or visit before a planned admission (or as soon as possible in an emergency) and tell us your scheme or insurer.',
  },
  {
    title: 'Share your documents',
    text: 'Bring your scheme or insurance card, photo ID and the doctor’s advice. We check what your scheme or policy covers.',
  },
  {
    title: 'Approval',
    text: 'We send the pre-authorisation request to the scheme, TPA or insurer and keep you updated on the approval.',
  },
  {
    title: 'Treatment & discharge',
    text: 'Covered treatment goes ahead under your scheme or policy. Our desk explains any charges that your scheme or policy does not cover.',
  },
];

const faqs = [
  {
    question: 'Is Medilife Superspeciality Hospital empanelled under CGHS?',
    answer:
      'Yes. Medilife Superspeciality Hospital, Dehradun is empanelled under the Central Government Health Scheme (CGHS). Please bring your CGHS card and any referral or permission documents that apply to your treatment.',
  },
  {
    question: 'Do you accept the CAPF Golden Card?',
    answer:
      'Yes. The hospital is empanelled under CAPF (Central Armed Police Forces). Please bring your CAPF Golden Card and the documents your scheme requires.',
  },
  {
    question: 'Can I get treatment with my Ayushman card (PM-JAY)?',
    answer:
      'Yes. Ayushman card holders can be treated under Ayushman Bharat PM-JAY for the procedures and packages covered by the scheme. Bring your Ayushman card and Aadhaar card.',
  },
  {
    question: 'Is treatment cashless with private health insurance?',
    answer:
      'We accept private health insurance through TPAs. Eligible treatment can be cashless once your insurer approves the pre-authorisation. Call our insurance desk to check whether your insurer is covered.',
  },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Insurance', item: new URL('/insurance', site.url).href },
  ],
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${title} - ${site.name}`,
  url: new URL('/insurance', site.url).href,
  description,
  about: hospitalRef,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<BaseLayout title="Insurance, CGHS, CAPF & TPA" description={description} jsonLd={[pageSchema, breadcrumbSchema, faqSchema]}>
  <PageHero
    eyebrow="Insurance Facilities"
    title="Healthcare Insurance, TPA & Government Health Schemes"
    subtitle={`Medilife Superspeciality Hospital, Dehradun is ${empanelmentLine.charAt(0).toLowerCase()}${empanelmentLine.slice(1)}, and accepts Ayushman Bharat (PM-JAY) and private health insurance through TPAs.`}
    crumbs={[{ label: 'Insurance' }]}
  />

  <!-- Empanelment & certification logos -->
  <AccreditationStrip insuranceLink={false} />

  <!-- A: Government health schemes -->
  <section class="section">
    <div class="container-x">
      <SectionHeading
        eyebrow="A. Government Health Schemes"
        title="Government schemes we accept"
        subtitle="Beneficiaries of these schemes can be treated at Medilife for the services their scheme covers. Bring your scheme card when you visit."
      />
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {governmentSchemes.map((s, i) => (
          <article class="card flex flex-col p-7">
            <div class="flex items-center justify-between gap-3">
              <span class="grid h-14 w-14 place-items-center rounded-2xl bg-brand-50 text-brand-600">
                {s.short === 'PM-JAY' || schemeLogo(s.short) ? (
                  <Img src={schemeLogo(s.short) ?? pmjayBadge} alt="" width={40} class="h-10 w-10 object-contain" loading="lazy" />
                ) : (
                  <Icon name={s.icon} class="h-7 w-7" />
                )}
              </span>
              <span class="font-display text-4xl font-extrabold text-brand-100" aria-hidden="true">{i + 1}</span>
            </div>
            <h3 class="mt-5 text-2xl font-bold text-ink-900">{s.short}</h3>
            <p class="text-sm font-semibold text-brand-700">{s.name}</p>
            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-ink-600">{s.description}</p>
            <p class="mt-5 rounded-xl bg-ink-50 p-4 text-sm text-ink-700">
              <span class="font-bold text-ink-900">Bring: </span>{s.bring}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- B: TPA services & health insurance assistance -->
  <section class="section bg-ink-50/50">
    <div class="container-x">
      <SectionHeading
        eyebrow="B. TPA Services & Health Insurance"
        title="Health insurance assistance"
        subtitle="Our insurance desk works with your TPA or insurer so you can focus on treatment and recovery."
      />
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {tpaServices.map((t) => (
          <div class="card flex flex-col p-6">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={t.icon} class="h-6 w-6" />
            </span>
            <h3 class="mt-4 text-lg font-bold text-ink-900">{t.title}</h3>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-ink-600">{t.text}</p>
          </div>
        ))}
      </div>

      {tpaList.length > 0 ? (
        <div id="insurers" class="mt-12 scroll-mt-24 rounded-3xl border border-ink-100 bg-white p-5 shadow-soft sm:p-8">
          <h3 class="text-xl font-bold text-ink-900">Empanelled insurance companies & TPAs</h3>
          <ul class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
            {tpaList.map((name) => {
              const logo = insurerLogo(name);
              return (
                <li class="flex min-h-[5.5rem] flex-col items-center justify-center gap-2 rounded-xl border border-ink-100 bg-white p-3 text-center shadow-soft">
                  {logo && <Img src={logo} alt="" width={120} class="h-10 w-auto max-w-full object-contain" loading="lazy" />}
                  <span class:list={['font-semibold leading-snug text-ink-800', logo ? 'text-xs' : 'text-sm']}>{name}</span>
                </li>
              );
            })}
          </ul>
          {institutions.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-ink-700">
              <span class="font-bold text-ink-900">Institutional tie-up:</span>
              {institutions.map((name) => {
                const logo = insurerLogo(name);
                return (
                  <span class="inline-flex items-center gap-2">
                    {logo && <Img src={logo} alt="" width={64} class="h-8 w-auto object-contain" loading="lazy" />}
                    {name}
                  </span>
                );
              })}
            </div>
          )}
          <p class="mt-3 text-sm text-ink-600">
            Insurer not listed? Call {contact.phoneDisplay} and our insurance desk will check for you.
          </p>
        </div>
      ) : (
        <div class="mt-12 flex flex-col items-start gap-5 rounded-3xl border border-ink-100 bg-white p-8 shadow-soft md:flex-row md:items-center md:justify-between">
          <div>
            <h3 class="text-xl font-bold text-ink-900">Is your insurer covered?</h3>
            <p class="mt-2 max-w-2xl text-ink-600">
              Call our insurance desk with your insurer or TPA name and policy number and we will check cashless
              eligibility for you before your visit.
            </p>
          </div>
          <div class="flex shrink-0 flex-col gap-3 sm:flex-row">
            <a href={contact.phoneHref} class="btn btn-primary"><Icon name="phone" class="h-5 w-5" /> {contact.phoneDisplay}</a>
            <a href={contact.whatsappHref} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="whatsapp" class="h-5 w-5" /> WhatsApp</a>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- How cashless works + documents -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <span class="eyebrow">How It Works</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">Cashless treatment, step by step</h2>
        <ol class="mt-8 grid gap-5">
          {steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-700 font-bold text-white">{i + 1}</span>
              <div>
                <h3 class="text-lg font-bold text-ink-900">{s.title}</h3>
                <p class="mt-1 text-[0.95rem] leading-relaxed text-ink-600">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <aside class="self-start rounded-3xl bg-brand-50 p-7">
        <h2 class="text-xl font-bold text-ink-900">Documents to bring</h2>
        <ul class="mt-5 grid gap-3">
          {insuranceDocuments.map((d) => (
            <li class="flex items-start gap-2.5 text-[0.95rem] text-ink-700">
              <Icon name="checkCircle" class="mt-0.5 h-5 w-5 shrink-0 text-brand-600" /> {d}
            </li>
          ))}
        </ul>
        <p class="mt-6 text-sm text-ink-600">
          Coverage, eligibility and approval are decided by your scheme, TPA or insurer as per their rules.
          Please carry original cards along with photocopies.
        </p>
      </aside>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-ink-50/50">
    <div class="container-x">
      <SectionHeading eyebrow="Insurance FAQ" title="Common questions about insurance and schemes" />
      <div class="mt-10">
        <FaqAccordion items={faqs} />
      </div>
    </div>
  </section>

  <!-- Enquiry -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Insurance Desk</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">Questions about your scheme or policy?</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">
          Send us your details with your scheme or insurer name and our team will call you back. For emergencies, we are available 24/7.
        </p>
        <a href={contact.phoneHref} class="mt-8 flex items-center gap-4">
          <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name="phone" class="h-6 w-6" /></span>
          <span><span class="block text-sm font-semibold text-ink-600">Call</span><span class="text-lg font-bold text-ink-900">{contact.phoneDisplay}</span></span>
        </a>
      </div>
      <div class="card p-6 sm:p-8">
        <ContactForm heading="Request a call back" />
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
