---
import Img from '../components/Img.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DoctorCard from '../components/DoctorCard.astro';
import ContactForm from '../components/ContactForm.astro';
import VideoCard from '../components/VideoCard.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Icon from '../components/Icon.astro';
import EventAnnouncement from '../components/EventAnnouncement.astro';
import { getImage } from 'astro:assets';
import { departments } from '../data/departments';
import { doctors } from '../data/doctors';
import { site, contact } from '../data/site';
import { videosForDepartment } from '../data/videos';
import { campaignsForDepartment } from '../data/gallery';
import { eventsFor } from '../data/events';
import { hospitalRef, specialtiesFor, doctorId } from '../data/schema';

export function getStaticPaths() {
  return departments.map((d) => ({ params: { department: d.slug }, props: { dept: d } }));
}

const { dept } = Astro.props;
// All consultants in this department, lead first.
const deptDoctors = doctors
  .filter((doc) => doc.department === dept.slug)
  .sort((a, b) => (a.slug === dept.leadDoctor ? -1 : b.slug === dept.leadDoctor ? 1 : 0));
const lead = deptDoctors.find((doc) => doc.slug === dept.leadDoctor) ?? deptDoctors[0];
const deptIndex = departments.findIndex((d) => d.slug === dept.slug);
const others = [1, 2, 3].map((k) => departments[(deptIndex + k) % departments.length]);
const deptVideos = videosForDepartment(dept.slug);
const deptEvents = eventsFor(dept.slug);
const deptPosters = campaignsForDepartment(dept.slug);
// Full-size poster for "view larger" (build-time WebP in production).
const posterFull = await Promise.all(
  deptPosters.map(async (c) =>
    import.meta.env.PROD
      ? (await getImage({ src: c.src, width: Math.min(1080, c.src.width), format: 'webp', quality: 80 })).src
      : c.src.src
  )
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalClinic',
    name: `${dept.pageTitle} - ${site.name}`,
    url: new URL(`/${dept.slug}`, site.url).href,
    ...(specialtiesFor(dept.slug).length ? { medicalSpecialty: specialtiesFor(dept.slug) } : {}),
    parentOrganization: hospitalRef,
    ...(deptDoctors.length ? { employee: deptDoctors.map((d) => ({ '@id': doctorId(d) })) } : {}),
    telephone: contact.phoneRaw,
    address: {
      '@type': 'PostalAddress',
      streetAddress: contact.addressLine1,
      addressLocality: contact.addressCity,
      addressRegion: contact.addressState,
      postalCode: contact.addressPostal,
      addressCountry: 'IN',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Departments', item: new URL('/departments', site.url).href },
      { '@type': 'ListItem', position: 3, name: dept.name, item: new URL(`/${dept.slug}`, site.url).href },
    ],
  },
  ...deptVideos.map((v) => ({
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: v.title,
    description: v.description,
    thumbnailUrl: new URL(v.poster.src, site.url).href,
    contentUrl: new URL(v.src, site.url).href,
    uploadDate: v.uploadDate,
    duration: v.duration,
    ...(v.inLanguage ? { inLanguage: v.inLanguage } : {}),
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
  })),
];
---

<BaseLayout
  title={dept.seoTitle ?? dept.pageTitle}
  description={dept.metaDescription}
  jsonLd={schema}
>
  <PageHero
    eyebrow={dept.featured ? 'Flagship Department' : 'Department'}
    title={dept.pageTitle}
    subtitle={dept.tagline}
    crumbs={[{ label: 'Departments', href: '/departments' }, { label: dept.name }]}
  />

  {deptEvents.map((e) => <EventAnnouncement event={e} />)}

  <!-- Overview -->
  <section class="section">
    <div class="container-x grid items-start gap-12 lg:grid-cols-[1.5fr_1fr]">
      <div>
        <span class="eyebrow" style={`color:${dept.colorDark};background:${dept.bg};border-color:${dept.bg}`}>
          <Icon name={dept.icon} class="h-4 w-4" /> {dept.name}
        </span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">{dept.name} care in Dehradun</h2>
        {dept.overview.map((p) => (
          <p class="mt-4 text-lg leading-relaxed text-ink-600">{p}</p>
        ))}

        <h3 class="mt-8 text-lg font-bold text-ink-900">Key focus areas</h3>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {dept.highlights.map((h) => (
            <li class="flex items-start gap-2.5">
              <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full text-white" style={`background:${dept.color}`}>
                <Icon name="check" class="h-3.5 w-3.5" />
              </span>
              <span class="text-[0.95rem] text-ink-700">{h}</span>
            </li>
          ))}
        </ul>
      </div>

      <aside class="flex flex-col gap-6">
        <div class="overflow-hidden rounded-3xl shadow-card ring-1 ring-ink-100">
          {dept.image ? (
            <Img
              src={dept.image}
              alt={`${dept.name} department at ${site.name}`}
              width={560}
              height={400}
              class="h-56 w-full object-cover"
              loading="eager"
            />
          ) : (
            <div class="grid h-56 w-full place-items-center" style={`background:${dept.bg}`}>
              <Icon name={dept.icon} class="h-20 w-20" style={`color:${dept.color}`} />
            </div>
          )}
        </div>
        <div class="rounded-3xl p-6 text-white shadow-card" style={`background:${dept.colorDark}`}>
          <h3 class="text-lg font-bold text-white">Book a consultation</h3>
          <p class="mt-2 text-sm text-white">Speak with our {dept.name} team. We are available 24/7 for emergencies.</p>
          <div class="mt-5 flex flex-col gap-2.5">
            <a href={`/book-online?department=${dept.slug}#appointment-form`} class="btn btn-white w-full">
              <Icon name="calendar" class="h-5 w-5" /> Book Appointment
            </a>
            <a href={contact.phoneHref} class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/30 px-4 py-3 text-sm font-semibold text-white transition hover:bg-white/10">
              <Icon name="phone" class="h-4 w-4" /> {contact.phoneDisplay}
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Procedures -->
  <section class="section bg-ink-50/50">
    <div class="container-x">
      <span class="eyebrow">Treatments & Procedures</span>
      <h2 class="mt-4 text-3xl font-bold text-ink-900">What we offer</h2>
      <p class="mt-3 max-w-2xl text-lg text-ink-600">
        {dept.proceduresIntro ?? `Our ${dept.name} department offers the consultations, tests and treatments below.`}
      </p>
      <div class="mt-10 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {dept.procedures.map((p) => (
          <div class="flex items-center gap-3 rounded-xl border border-ink-100 bg-white p-4 shadow-soft transition hover:border-brand-200 hover:shadow-card">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg" style={`background:${dept.bg};color:${dept.colorDark}`}>
              <Icon name="check" class="h-5 w-5" />
            </span>
            <span class="text-[0.92rem] font-medium text-ink-800">{p}</span>
          </div>
        ))}
      </div>

      {dept.conditions && dept.conditions.length > 0 && (
        <div class="mt-12 rounded-3xl border border-ink-100 bg-white p-8 shadow-soft">
          <h3 class="text-xl font-bold text-ink-900">Conditions we treat</h3>
          <div class="mt-5 flex flex-wrap gap-2.5">
            {dept.conditions.map((c) => (
              <span class="rounded-full bg-brand-50 px-4 py-2 text-sm font-medium text-brand-800">{c}</span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Patient-education videos -->
  {deptVideos.length > 0 && (
    <section class="section bg-ink-50/50">
      <div class="container-x">
        <span class="eyebrow">Watch & Learn</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">Videos from our specialists</h2>
        <div class="reveal mt-8 grid items-start gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {deptVideos.map((v) => <VideoCard video={v} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Health-awareness posters from this department -->
  {deptPosters.length > 0 && (
    <section class="section">
      <div class="container-x">
        <span class="eyebrow">Health Awareness</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">{dept.name} awareness posters</h2>
        <p class="mt-3 max-w-2xl text-lg text-ink-600">Simple guidance from our {dept.name} team on symptoms, tests and treatment options. Tap a poster to view it full size.</p>
        <div class="reveal mt-8 grid grid-cols-2 items-start gap-4 sm:grid-cols-3 lg:grid-cols-4">
          {deptPosters.map((c, i) => (
            <a
              href={posterFull[i]}
              target="_blank"
              rel="noopener"
              class="block overflow-hidden rounded-2xl bg-white shadow-soft ring-1 ring-ink-100 transition hover:shadow-card"
            >
              <Img
                src={c.src}
                alt={c.alt}
                width={288}
                sizes="(min-width: 1024px) 288px, (min-width: 640px) 30vw, 46vw"
                class="h-auto w-full"
                loading="lazy"
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Consultants -->
  {deptDoctors.length > 0 && (
    <section class="section">
      <div class="container-x">
        <span class="eyebrow">{deptDoctors.length > 1 ? 'Your Specialists' : 'Your Specialist'}</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">
          {deptDoctors.length > 1 ? 'Meet the consultants' : 'Meet the consultant'}
        </h2>
        {deptDoctors.length > 1 ? (
          <div class="reveal mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {deptDoctors.map((d) => <DoctorCard doctor={d} />)}
          </div>
        ) : (
          <div class="mt-8 grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
            <div class="max-w-sm">
              <DoctorCard doctor={lead} />
            </div>
            <div>
              <h3 class="text-2xl font-bold text-ink-900">
                <a href={`/doctors/${lead.slug}`} class="transition hover:text-brand-700">{lead.name}</a>
              </h3>
              <p class="mt-1 font-semibold text-brand-700">{lead.title}</p>
              <p class="mt-4 text-lg leading-relaxed text-ink-600">{lead.bio}</p>
              {lead.opd && (
                <p class="mt-3 inline-flex items-center gap-2 rounded-lg bg-brand-50 px-3 py-2 text-sm font-semibold text-brand-700">
                  <Icon name="clock" class="h-4 w-4" /> OPD: {lead.opd}
                </p>
              )}
              <div class="mt-6">
                <a href={`/book-online?doctor=${lead.slug}#appointment-form`} class="btn btn-primary">
                  <Icon name="calendar" class="h-5 w-5" /> Book with {lead.name.split(' ').slice(0, 2).join(' ')}
                </a>
              </div>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Related departments -->
  <section class="section bg-ink-50/50">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="eyebrow">Explore More</span>
          <h2 class="mt-4 text-3xl font-bold text-ink-900">Other departments</h2>
        </div>
        <a href="/departments" class="btn btn-ghost">All departments <Icon name="arrowRight" class="h-5 w-5" /></a>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-3">
        {others.map((d) => (
          <a href={`/${d.slug}`} class="card card-hover group flex items-center gap-4 p-5">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl text-white" style={`background:${d.color}`}>
              <Icon name={d.icon} class="h-6 w-6" />
            </span>
            <span class="flex flex-col">
              <span class="font-bold text-ink-900 group-hover:text-brand-700">{d.name}</span>
              <span class="text-sm text-ink-600">{d.tagline}</span>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Enquiry -->
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <span class="eyebrow">Enquire Now</span>
        <h2 class="mt-4 text-3xl font-bold text-ink-900">Have a question about {dept.name}?</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">
          Send us your details and our team will get back to you. For urgent help, call us any time.
        </p>
        <div class="mt-8 flex flex-col gap-4">
          <a href={contact.phoneHref} class="flex items-center gap-4">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name="phone" class="h-6 w-6" /></span>
            <span><span class="block text-sm font-semibold text-ink-600">Call</span><span class="text-lg font-bold text-ink-900">{contact.phoneDisplay}</span></span>
          </a>
          <a href={contact.emailHref} class="flex items-center gap-4">
            <span class="grid h-12 w-12 place-items-center rounded-xl bg-brand-50 text-brand-600"><Icon name="mail" class="h-6 w-6" /></span>
            <span><span class="block text-sm font-semibold text-ink-600">Email</span><span class="text-lg font-bold text-ink-900">{contact.email}</span></span>
          </a>
        </div>
      </div>
      <div class="card p-6 sm:p-8">
        <ContactForm heading="Request a call back" department={dept.slug} />
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>
